---
const name = "Oscar Villarreal Chaccourt";
const title = "Cloud Engineer";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{name} — CV</title>
</head>
<body>
  <div class="page">
    <header class="cv-header">
      <h1>{name}</h1>
      <div class="cv-title">{title}</div>
      <div class="cv-contact">
        <span>+52 866-186-3027</span>
        <span>·</span>
        <span>oscar@villarrealc.com</span>
        <span>·</span>
        <span>linkedin.com/in/oscarvillarrealc</span>
        <span>·</span>
        <span>villarrealc.com</span>
      </div>
    </header>

    <section class="section">
      <h2>Education</h2>
      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">Bachelor of Science, Computer Science and Technology</span>
          <span class="entry-date">Aug 2019 – Dec 2024</span>
        </div>
        <div class="entry-sub">Universidad de Monterrey · San Pedro Garza García, Nuevo León</div>
        <ul class="bullets">
          <li>Completed elective courses in Artificial Intelligence, Usability, and Database Applications</li>
        </ul>
      </div>
    </section>

    <section class="section">
      <h2>Languages</h2>
      <div class="lang-row">
        <span><strong>Spanish</strong> — Native</span>
        <span><strong>English</strong> — Full professional proficiency</span>
        <span><strong>French</strong> — Elementary proficiency</span>
      </div>
    </section>

    <section class="section">
      <h2>Technical Skills</h2>
      <div class="skills">
        <div class="skill-row"><span class="skill-label">Languages</span><span>Python, PHP, JavaScript, TypeScript, Go, SQL</span></div>
        <div class="skill-row"><span class="skill-label">Frameworks</span><span>Laravel, Django, FastAPI, React, React Native, Next.js, Tailwind CSS</span></div>
        <div class="skill-row"><span class="skill-label">Cloud &amp; Infrastructure</span><span>Google Cloud Platform (Cloud Run, Cloud SQL, Cloud Build), Terraform, Docker, Linux, Apache, Nginx, Cloudflare</span></div>
        <div class="skill-row"><span class="skill-label">CI/CD &amp; DevOps</span><span>Git, GitHub Actions, Cloud Build, CI/CD pipelines, containerized deployments</span></div>
        <div class="skill-row"><span class="skill-label">Databases</span><span>PostgreSQL, MySQL, Redis</span></div>
        <div class="skill-row"><span class="skill-label">Architecture &amp; Systems</span><span>Microservices, Multi-tenant architectures, REST API design, distributed systems</span></div>
      </div>
    </section>

    <section class="section">
      <h2>Experience</h2>

      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">Aindez — Cloud Engineer</span>
          <span class="entry-date">Oct 2025 – Present</span>
        </div>
        <ul class="bullets">
          <li>Designed and deployed a multi-tenant architecture with per-organization service isolation</li>
          <li>Built infrastructure using Terraform with automated provisioning and environment management</li>
          <li>Implemented CI/CD pipelines for deployments and database migrations</li>
          <li>Orchestrated services across cloud providers (GCP, Railway)</li>
          <li>Managed PostgreSQL databases with tenant isolation strategies</li>
          <li>Built a Go CLI for platform administration (login, org switching, schema import/export, integrations, routines)</li>
        </ul>
      </div>

      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">Industrias Vago México — Full Stack Developer</span>
          <span class="entry-date">Apr 2025 – Present</span>
        </div>
        <ul class="bullets">
          <li>Designed and deployed a full e-commerce ecosystem (web + mobile)</li>
          <li>Implemented API-first architecture shared across web and React Native clients</li>
          <li>Built Dockerized microservices and integrated caching with Redis</li>
          <li>Developed CI/CD pipelines for automated deployments</li>
          <li>Managed cloud infrastructure and server configuration (GCP, Linux, Apache/Nginx)</li>
        </ul>
      </div>

      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">DITSI — Junior Frontend Developer (Internship)</span>
          <span class="entry-date">Aug 2023 – Dec 2023</span>
        </div>
        <ul class="bullets">
          <li>Developed responsive UI components for a university system</li>
          <li>Improved usability and performance through testing and optimization</li>
        </ul>
      </div>
    </section>
  </div>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #e9e9ec;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #161616;
    }

    .page {
      width: 8.5in;
      min-height: 11in;
      margin: 2rem auto;
      background: #fff;
      padding: 0.6in 0.75in;
      box-shadow: 0 0 0 1px #d6d6da, 0 6px 24px rgba(0, 0, 0, 0.12);
      font-size: 10pt;
      line-height: 1.45;
    }

    .cv-header { margin-bottom: 1rem; }
    .cv-header h1 {
      font-size: 20pt;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .cv-title {
      font-size: 10.5pt;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #444;
      margin-top: 0.15rem;
    }
    .cv-contact {
      margin-top: 0.4rem;
      font-size: 9pt;
      color: #444;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .section { margin-top: 1.5rem; }
    .section h2 {
      font-size: 9.5pt;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-bottom: 1px solid #ccc;
      padding-bottom: 0.2rem;
      margin-bottom: 0.6rem;
    }

    .entry { margin-bottom: 0.65rem; }
    .entry:last-child { margin-bottom: 0; }

    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.5rem;
    }
    .entry-title { font-weight: 600; font-size: 10pt; }
    .entry-date { font-size: 9pt; color: #555; white-space: nowrap; }
    .entry-sub { font-size: 9pt; color: #555; margin-top: 0.1rem; }

    .bullets { margin-top: 0.3rem; padding-left: 1.1rem; }
    .bullets li { margin-bottom: 0.15rem; }
    .bullets li:last-child { margin-bottom: 0; }

    .lang-row {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      font-size: 9.5pt;
    }

    .skills { display: flex; flex-direction: column; gap: 0.3rem; }
    .skill-row {
      display: flex;
      gap: 0.6rem;
      font-size: 9.5pt;
    }
    .skill-label {
      font-weight: 600;
      width: 150px;
      flex-shrink: 0;
    }

    @media print {
      body { background: #fff; }
      .page {
        width: auto;
        min-height: auto;
        margin: 0;
        padding: 0;
        box-shadow: none;
      }
      @page { size: Letter; margin: 0.6in 0.75in; }
    }
  </style>
</body>
</html>
