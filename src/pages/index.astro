---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <style>
    .reading-progress {
      position: fixed;
      top: 56px;
      left: 0;
      right: 0;
      height: 2px;
      z-index: 99;
      background: var(--border);
      pointer-events: none;
    }
    .reading-progress-fill {
      height: 100%;
      background: var(--accent);
      transition: width 0.1s linear;
      width: 0%;
    }

    section { padding: 4rem 0; border-bottom: 1px solid var(--border); }
    section:last-child { border-bottom: none; }
    section:not(#hero) { max-width: 720px; margin-left: auto; margin-right: auto; }

    /* Hero */
    #hero {
      padding: 0;
      border-bottom: none;
      overflow: hidden;
      background: var(--bg);
      position: relative;
      left: 50%;
      transform: translateX(-50%);
      width: 100vw;
    }

    .hero-inner {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 1.5rem;
      display: flex;
      align-items: flex-end;
    }

    .hero-photo-col {
      width: 320px;
      flex-shrink: 0;
      position: relative;
      overflow: hidden;
      align-self: flex-end;
      padding-bottom: 4rem;
    }
    .hero-photo-col::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, transparent 50%, var(--bg) 100%);
    }
    .hero-photo-col img {
      width: 100%;
      display: block;
      object-position: center top;
      filter: grayscale(15%);
    }

    .hero-text {
      flex: 1;
      padding: 4rem 1.5rem 4rem 2rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .eyebrow {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .eyebrow::before {
      content: '';
      width: 20px;
      height: 1px;
      background: var(--accent);
      flex-shrink: 0;
    }

    h1 {
      font-size: clamp(1.625rem, 3.25vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.035em;
      line-height: 1.15;
      margin-bottom: 1rem;
    }
    h1 em { font-style: normal; color: var(--muted); font-weight: 400; }

    .hero-desc {
      font-size: 0.975rem;
      color: var(--muted);
      margin-bottom: 2rem;
      line-height: 1.75;
    }

    .hero-links { display: flex; gap: 0.6rem; flex-wrap: wrap; }

    @media (max-width: 640px) {
      .hero-inner { flex-direction: column; }
      .hero-photo-col { width: 100%; padding-bottom: 0; align-self: auto; }
      .hero-photo-col::after {
        background: linear-gradient(to bottom, transparent 50%, var(--bg) 100%);
      }
      .hero-text { padding: 2rem 1.5rem 3rem; }
      h1 em { display: block; }
    }

    /* Section headings */
    h2 {
      font-size: 1.375rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 2rem;
    }

    /* Projects */
    .projects { display: flex; flex-direction: column; gap: 1.25rem; }

    .project-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.5rem;
      transition: border-color 0.15s, background 0.15s;
    }
    .project-card:hover { border-color: var(--border-hover); background: var(--surface-hover); }

    .project-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.6rem;
    }

    .project-name {
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    a.project-name {
      color: inherit;
      text-decoration: none;
    }
    a.project-name:hover { color: var(--accent); }
    .project-icon {
      width: 20px;
      height: 20px;
      object-fit: contain;
      flex-shrink: 0;
      display: block;
    }

    .project-label {
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      background: var(--accent-dim);
      color: var(--accent);
      white-space: nowrap;
    }

    .project-date {
      font-size: 0.78rem;
      color: var(--muted);
      white-space: nowrap;
    }

    .project-desc {
      font-size: 0.925rem;
      color: var(--muted);
      margin-bottom: 1rem;
      line-height: 1.65;
    }

    .tag-list { display: flex; flex-wrap: wrap; gap: 0.4rem; }

    .tag {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }
    .tag i { font-size: 0.85rem; line-height: 1; }
    .tag .devicon-github-original,
    .tag .devicon-django-plain { color: var(--fg); }
    .tag img { width: 14px; height: 14px; flex-shrink: 0; }

    /* Stack */
    .stack-category { margin-bottom: 1.75rem; }
    .stack-category:last-child { margin-bottom: 0; }

    .stack-category-label {
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.65rem;
    }

    .stack-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
      gap: 0.65rem;
    }

    .stack-item {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.85rem 0.5rem 0.7rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      min-height: 72px;
      transition: border-color 0.15s, background 0.15s;
    }
    .stack-item:hover { border-color: var(--border-hover); background: var(--surface-hover); }
    .stack-item.learning {
      border-style: dashed;
      border-color: rgba(245, 158, 11, 0.45);
      background: rgba(245, 158, 11, 0.06);
    }
    .stack-item.learning:hover { border-color: rgba(245, 158, 11, 0.7); }
    .stack-item.learning span { color: #f59e0b; }
    .stack-item i { font-size: 1.875rem; line-height: 1; }
    .stack-item .devicon-linux-plain,
    .stack-item .devicon-github-original,
    .stack-item .devicon-django-plain { color: var(--fg); }
    .stack-item img { width: 1.875rem; height: 1.875rem; object-fit: contain; }
    .stack-item span { font-size: 0.7rem; color: var(--muted); text-align: center; line-height: 1.3; }

    /* Languages */
    .lang-list { display: flex; flex-direction: column; gap: 0.85rem; }

    .lang-item {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .lang-name {
      font-size: 0.925rem;
      font-weight: 500;
      width: 80px;
      flex-shrink: 0;
    }

    .lang-level {
      font-size: 0.78rem;
      color: var(--muted);
      width: 180px;
      flex-shrink: 1;
      min-width: 0;
    }

    .lang-dots {
      display: flex;
      gap: 0.35rem;
    }

    .lang-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--border);
    }
    .lang-dot.filled { background: var(--accent); }

    /* Education */
    .edu-card {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.5rem;
      transition: border-color 0.15s, background 0.15s;
    }
    .edu-card:hover { border-color: var(--border-hover); background: var(--surface-hover); }

    .edu-logo {
      width: 48px;
      height: 48px;
      object-fit: contain;
      flex-shrink: 0;
      border-radius: 8px;
    }

    .edu-degree {
      font-size: 0.975rem;
      font-weight: 600;
      margin-bottom: 0.2rem;
    }

    .edu-school {
      font-size: 0.875rem;
      color: var(--muted);
      margin-bottom: 0.2rem;
    }

    .edu-period {
      font-size: 0.78rem;
      color: var(--muted);
    }

    @media (max-width: 480px) {
      .lang-item { flex-wrap: wrap; row-gap: 0.35rem; }
      .lang-name { width: 100%; }
      .lang-level { width: auto; }
    }

    /* Theme-aware icons — must come after .project-icon to override display: block */
    .theme-icon-light { display: none; }
    :global([data-theme="light"]) .theme-icon-dark { display: none; }
    :global([data-theme="light"]) .theme-icon-light { display: block; }

    /* Certifications */
    .cert-list { display: flex; flex-direction: column; gap: 1rem; }

    .cert-card {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem 1.5rem;
      transition: border-color 0.15s, background 0.15s;
    }
    .cert-card:hover { border-color: var(--border-hover); background: var(--surface-hover); }

    .cert-icon {
      width: 48px;
      flex-shrink: 0;
      font-size: 2.25rem;
      line-height: 1;
      text-align: center;
    }

    .cert-info { flex: 1; min-width: 0; }

    .cert-name {
      font-size: 0.975rem;
      font-weight: 600;
      margin-bottom: 0.2rem;
    }

    .cert-issuer {
      font-size: 0.875rem;
      color: var(--muted);
    }

    .cert-dates {
      font-size: 0.8rem;
      color: var(--muted);
      margin-top: 0.15rem;
    }

    .cert-status {
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      padding: 0.25rem 0.65rem;
      border-radius: 4px;
      background: rgba(251,191,36,0.15);
      color: #f59e0b;
      white-space: nowrap;
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }
    .cert-status svg { width: 11px; height: 11px; }

    .cert-status.verified {
      background: rgba(34,197,94,0.15);
      color: #22c55e;
    }

    @media (max-width: 480px) {
      .cert-card { flex-wrap: wrap; }
      .cert-status { margin-left: calc(48px + 1.25rem); }
    }

    /* About */
    .about-text { font-size: 1rem; color: var(--muted); line-height: 1.75; }
    .about-text p + p { margin-top: 1rem; }

  </style>

  <div class="reading-progress">
    <div class="reading-progress-fill" id="reading-progress-fill"></div>
  </div>

  <!-- Hero -->
  <section id="hero">
    <div class="hero-inner">
      <div class="hero-photo-col">
        <img src="/oscar.png" alt="Oscar Villarreal" />
      </div>
      <div class="hero-text">
        <div class="eyebrow">Monterrey, Mexico</div>
        <h1>
          <span data-lang="en">Cloud Engineer &amp;<br><em>Infrastructure Specialist</em></span>
          <span data-lang="es">Ingeniero de la Nube<br><em>e Infraestructura</em></span>
        </h1>
        <p class="hero-desc">
          <span data-lang="en">I build multi-tenant SaaS platforms, cloud infrastructure, and the occasional side project that's more fun than it needs to be.</span>
          <span data-lang="es">Construyo plataformas SaaS multi-tenant e infraestructura en la nube, y de vez en cuando algún proyecto personal solo por gusto.</span>
        </p>
        <div class="hero-links">
          <a class="btn btn-primary" href="/Oscar%20Villarreal%20Chaccourt%20CV.pdf" target="_blank">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span data-lang="en">Download CV</span>
            <span data-lang="es">Descargar CV</span>
          </a>
          <a class="btn btn-ghost" href="mailto:oscar@villarrealc.com">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span data-lang="en">Get in touch</span>
            <span data-lang="es">Contáctame</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects">
    <h2>
      <span data-lang="en">Projects</span>
      <span data-lang="es">Proyectos</span>
    </h2>
    <div class="projects">

      <div class="project-card">
        <div class="project-header">
          <a href="https://aindez.ai" target="_blank" rel="noopener noreferrer" class="project-name"><img src="/icons/aindez.svg" class="project-icon" alt="" />Aindez</a>
          <div style="display:flex;gap:0.6rem;align-items:center;flex-wrap:wrap;">
            <span class="project-date">
              <span data-lang="en">Oct 2025 – Present</span>
              <span data-lang="es">Oct 2025 – Presente</span>
            </span>
            <span class="project-label">
              <span data-lang="en">Main</span><span data-lang="es">Principal</span>
            </span>
          </div>
        </div>
        <p class="project-desc" data-lang="en">
          Aindez is an AI-native platform for managing workforce operations: an AI agent layer (Agno,
          orchestrating Claude/OpenAI/Gemini) connects HCM, ATS, and ERP systems (Humand, HiringRoom,
          Teamtailor, Alegra) into one place, driving chat-based workflows, scheduled routines, and
          knowledge-base Q&amp;A over each org's data.
        </p>
        <p class="project-desc" data-lang="en">
          My role: designed and built the multi-tenant system architecture (Terraform + Cloud Build
          provisioning on GCP, giving every organization its own isolated Cloud Run service and Cloud SQL
          instance), plus most of the third-party integrations, GCS-based image/file storage with signed
          URLs, a Go CLI for interacting with the platform from the terminal (login, org switching, schema
          import/export, integrations, routines), and UI work throughout the app.
        </p>
        <p class="project-desc" data-lang="es">
          Aindez es una plataforma nativa en IA para gestionar la operación de tu equipo: una capa de
          agentes de IA (Agno, orquestando Claude/OpenAI/Gemini) conecta sistemas de HCM, ATS y ERP
          (Humand, HiringRoom, Teamtailor, Alegra) en un solo lugar, impulsando flujos por chat, rutinas
          programadas y respuestas tipo Q&amp;A sobre los datos de cada organización.
        </p>
        <p class="project-desc" data-lang="es">
          Mi rol: diseñé y construí la arquitectura multi-tenant del sistema (aprovisionamiento con
          Terraform y Cloud Build en GCP, dando a cada organización su propio servicio en Cloud Run e
          instancia de Cloud SQL), además de la mayoría de las integraciones con terceros, almacenamiento
          de imágenes/archivos en GCS con URLs firmadas, un CLI en Go para interactuar con la plataforma
          desde la terminal (login, cambio de organización, import/export de esquemas, integraciones,
          rutinas), y trabajo de UI en varias partes de la app.
        </p>
        <div class="tag-list">
          <span class="tag"><i class="devicon-django-plain colored"></i>Django</span>
          <span class="tag"><i class="devicon-fastapi-plain colored"></i>FastAPI</span>
          <span class="tag"><i class="devicon-react-original colored"></i>React</span>
          <span class="tag"><i class="devicon-typescript-plain colored"></i>TypeScript</span>
          <span class="tag"><img src="/icons/tanstack.svg" alt="TanStack" />TanStack Router</span>
          <span class="tag"><i class="devicon-go-plain colored"></i>Go</span>
          <span class="tag"><i class="devicon-terraform-plain colored"></i>Terraform</span>
          <span class="tag"><img src="/icons/cloudbuild.svg" alt="Cloud Build" />Cloud Build</span>
          <span class="tag"><img src="/icons/cloudrun.svg" alt="Cloud Run" />Cloud Run</span>
          <span class="tag"><img src="/icons/cloudsql.svg" alt="Cloud SQL" />Cloud SQL</span>
          <span class="tag"><img src="/icons/gcs.svg" alt="GCS" />GCS</span>
          <span class="tag"><i class="devicon-docker-plain colored"></i>Docker</span>
          <span class="tag"><img src="/icons/workos.svg" alt="WorkOS" />WorkOS</span>
          <span class="tag"><i class="devicon-postgresql-plain colored"></i>PostgreSQL</span>
          <span class="tag"><i class="devicon-redis-plain colored"></i>Redis</span>
        </div>
      </div>

      <div class="project-card">
        <div class="project-header">
          <a href="https://vazel.com" target="_blank" rel="noopener noreferrer" class="project-name"><img src="/icons/vazel-logo.svg" class="project-icon" alt="" />VAZEL</a>
          <div style="display:flex;gap:0.6rem;align-items:center;flex-wrap:wrap;">
            <span class="project-date">
              <span data-lang="en">Apr 2025 – Present</span>
              <span data-lang="es">Abr 2025 – Presente</span>
            </span>
            <span class="project-label">
              <span data-lang="en">Main</span><span data-lang="es">Principal</span>
            </span>
          </div>
        </div>
        <p class="project-desc" data-lang="en">
          Solo-designed and built this e-commerce and CRM platform for a Mexican industrial mechanical
          seals company, end to end: backend, frontend, infrastructure, and integrations. Features an
          AI-powered sales assistant (Vertex AI / Dialogflow CX), product catalog with media storage on GCS,
          and a Filament admin panel with lead tracking.
        </p>
        <p class="project-desc" data-lang="es">
          Diseñé y construí esta plataforma de e-commerce y CRM yo solo, de principio a fin: backend,
          frontend, infraestructura e integraciones, para una empresa mexicana de sellos mecánicos
          industriales. Incluye un asistente de ventas con IA (Vertex AI / Dialogflow CX), catálogo de
          productos con almacenamiento en GCS, y panel de administración en Filament con seguimiento de
          leads.
        </p>
        <div class="tag-list">
          <span class="tag"><i class="devicon-laravel-plain colored"></i>Laravel</span>
          <span class="tag"><i class="devicon-laravel-plain colored"></i>Blade</span>
          <span class="tag"><i class="devicon-laravel-plain colored"></i>Filament</span>
          <span class="tag"><img src="/icons/cloudbuild.svg" alt="Cloud Build" />Cloud Build</span>
          <span class="tag"><img src="/icons/cloudsql.svg" alt="Cloud SQL" />Cloud SQL</span>
          <span class="tag"><img src="/icons/gcs.svg" alt="GCS" />GCS</span>
          <span class="tag"><i class="devicon-postgresql-plain colored"></i>PostgreSQL</span>
          <span class="tag"><i class="devicon-docker-plain colored"></i>Docker</span>
          <span class="tag"><img src="/icons/vertex.svg" alt="Vertex AI" />Vertex AI</span>
          <span class="tag"><img src="/icons/dialogflow.svg" alt="Dialogflow CX" />Dialogflow CX</span>
          <span class="tag"><i class="devicon-redis-plain colored"></i>Redis</span>
        </div>
      </div>

      <div class="project-card">
        <div class="project-header">
          <span class="project-name"><img src="/icons/vazel-logo.svg" class="project-icon" alt="" />VAZEL Mobile</span>
          <div style="display:flex;gap:0.6rem;align-items:center;flex-wrap:wrap;">
            <span class="project-date">
              <span data-lang="en">Apr 2025 – Present</span>
              <span data-lang="es">Abr 2025 – Presente</span>
            </span>
            <span class="project-label" style="background:rgba(251,191,36,0.15);color:#f59e0b;">
              <span data-lang="en">Public release soon</span><span data-lang="es">Lanzamiento público pronto</span>
            </span>
          </div>
        </div>
        <p class="project-desc" data-lang="en">
          React Native mobile companion app for the VAZEL platform. Lets field sales reps browse the product
          catalog, manage leads, and interact with the AI sales assistant from their phone.
        </p>
        <p class="project-desc" data-lang="es">
          App móvil en React Native complementaria a la plataforma VAZEL. Permite a los representantes de
          ventas consultar el catálogo de productos, gestionar leads e interactuar con el asistente de ventas
          con IA desde su teléfono.
        </p>
        <div class="tag-list">
          <span class="tag"><i class="devicon-react-original colored"></i>React Native</span>
          <span class="tag"><i class="devicon-typescript-plain colored"></i>TypeScript</span>
        </div>
      </div>

      <div class="project-card">
        <div class="project-header">
          <span class="project-name">
            <img src="/icons/oscar-dark.svg" class="project-icon theme-icon-dark" alt="" />
            <img src="/icons/oscar-light.svg" class="project-icon theme-icon-light" alt="" />
            <span data-lang="en">Personal Portfolio</span>
            <span data-lang="es">Portafolio Personal</span>
          </span>
          <span class="project-label">Personal</span>
        </div>
        <p class="project-desc" data-lang="en">
          Personal portfolio and blog. Built with Astro for static generation, Astro View Transitions
          for smooth client-side navigation, and content collections for the blog. Deployed via GitHub Actions to GitHub Pages.
        </p>
        <p class="project-desc" data-lang="es">
          Portafolio personal y blog. Construido con Astro para generación estática, Astro View Transitions
          para navegación fluida del lado del cliente y colecciones de contenido para el blog. Desplegado
          vía GitHub Actions en GitHub Pages.
        </p>
        <div class="tag-list">
          <span class="tag"><i class="devicon-astro-plain colored"></i>Astro</span>
          <span class="tag"><i class="devicon-typescript-plain colored"></i>TypeScript</span>
          <span class="tag"><i class="devicon-github-original colored"></i>GitHub Pages</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Stack -->
  <section id="stack">
    <h2>
      <span data-lang="en">Tech Stack</span>
      <span data-lang="es">Stack Tecnológico</span>
    </h2>

    <div class="stack-category">
      <div class="stack-category-label">Backend</div>
      <div class="stack-grid">
        <div class="stack-item"><i class="devicon-django-plain colored"></i><span>Django</span></div>
        <div class="stack-item"><i class="devicon-fastapi-plain colored"></i><span>FastAPI</span></div>
        <div class="stack-item"><i class="devicon-laravel-plain colored"></i><span>Laravel</span></div>
        <div class="stack-item"><i class="devicon-go-plain colored"></i><span>Go</span></div>
        <div class="stack-item"><i class="devicon-postgresql-plain colored"></i><span>PostgreSQL</span></div>
        <div class="stack-item"><i class="devicon-mysql-plain colored"></i><span>MySQL</span></div>
        <div class="stack-item"><i class="devicon-redis-plain colored"></i><span>Redis</span></div>
      </div>
    </div>

    <div class="stack-category">
